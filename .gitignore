# LTX macOS Deployment .gitignore
# Keep this repo clean — only deployment scripts, sample prompts, and docs.
# Do not track your personal prompts, experiments, or custom generation scripts.

# Ignore large model files and official LTX source
LTX-2/
models/
output*.mp4
*.safetensors
*.bin

# Personal prompts and custom work (untracked by default)
prompts/*.txt
!prompts/README.md
!prompts/*.sample
prompts/*.sh
custom_*.sh
my-*.sh

# Virtual environment
.venv/
__pycache__/
*.pyc

# Generated outputs
outputs/
*.mp4
*.mov
*.avi

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
/tmp/mlflow.log

# MLflow local database and run storage (machine-specific, do not commit)
mlflow.db
mlruns/

# Temporary setup files
setup-ltx-macos.sh.bak

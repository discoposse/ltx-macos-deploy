      "id": 5,
      "targets": [{ "expr": "ltx_memory_bytes", "legendFormat": "{{type}}", "refId": "A" }],
      "title": "Worker memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
